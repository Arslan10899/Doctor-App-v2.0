# --- runtime data ----------------------------------------------------------
# The SQLite database IS the single source of truth:
# it travels with git (local push -> PythonAnywhere pull).
# Only journal/wal side files stay out.
data/*.db-wal
data/*.db-shm
data/*.db-journal

# The old Firestore backup JSON stays ONLY on the local computer –
# nothing in the app reads it any more (import needs DOCTOR_APP_IMPORT_BACKUP=1).
data/firestore_backup.json

# uploaded media (doctor/hospital images+videos) travels with the repo too

# --- secrets – never commit ------------------------------------------------
# Firebase admin key is banned in this project. Auth users live in SQLite.
serviceAccountKey.json
*.env
.env.local

# R2 (Cloudflare) storage keys – created by hand on the PythonAnywhere
# console (~/Doctor-App-v2.0/backend/storage_settings.json); never in git.
backend/storage_settings.json

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- editor / OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
